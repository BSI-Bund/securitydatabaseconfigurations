# ------------------------------------------------------------
# .env for docker-compose.yml (Weaviate 1.34.0)
# ------------------------------------------------------------

# Image/Version (referenced in the compose file)
WEAVIATE_VERSION=1.34.0

# Network / Ports
WEAVIATE_HOST=0.0.0.0
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http
#WEAVIATE_GPRC_PORT=50051


# Timezone
TZ=Europe/Berlin

# Data Path
WEAVIATE_DATA_PATH=/var/lib/weaviate

# Default Query Limit
WEAVIATE_QUERY_LIMIT=100

# Cluster / Node Settings
WEAVIATE_CLUSTER_HOSTNAME=node1

# Telemetry / Logging
DISABLE_TELEMETRY=true
QUERY_SLOW_LOG_ENABLED=true

# ------------------------------------------------------------
# 🔐 Authentication & Authorization
# ------------------------------------------------------------
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
AUTHENTICATION_APIKEY_ENABLED=true
WEAVIATE_API_KEYS=example-key-12345,another-key-67890
WEAVIATE_API_USERS=admin,user
AUTHORIZATION_ENABLE_RBAC=true
WEAVIATE_ROOT_USERS=admin

# ------------------------------------------------------------
# 🧩 Modules (enable as needed)
# ------------------------------------------------------------
ENABLE_API_BASED_MODULES=true
ENABLE_MODULES=text2vec-ollama,generative-ollama
