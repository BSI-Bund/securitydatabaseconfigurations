# ------------------------------------------------------------
# Default .env for docker-compose.yml (PostgreSQL 18.6 + Adminer)
# WARNING: Example values only. Do NOT use in production without changing secrets.
# ------------------------------------------------------------

# Image/Version
POSTGRES_VERSION=18.6

# Timezone
TZ=Europe/Berlin

# Network / Ports
DB_PORT=5432
ADMINER_PORT=8080

# Bootstrap superuser for initialization and maintenance only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe!Root123

# Application database
POSTGRES_DB=appdb

# Example least-privilege application roles (change before use)
POSTGRES_APP_ADMIN_PASSWORD=S3cur3P@ss!
POSTGRES_APP_READER_PASSWORD=Read0nly!

# PostgreSQL 18 official image data directory
PGDATA=/var/lib/postgresql/18/docker
