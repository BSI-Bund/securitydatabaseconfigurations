# ===============================
# MySQL 8.4 - Sample my.cnf (Linux)
# With detailed comments and safe defaults
# ===============================

[client]
port   = 3306                                   # Default port for MySQL client
socket = /var/run/mysqld/mysqld.sock            # Socket for local connections (Unix/Linux)

# --- TLS/SSL for the client (optional) ---
# For secure client/server connections via certificates.
# New in MySQL: ssl-mode = VERIFY_IDENTITY checks hostname + certificate.
# ssl-mode = VERIFY_IDENTITY
# ssl-ca   = /etc/mysql/ssl/ca-cert.pem         # CA certificate (server and client share)
# ssl-cert = /etc/mysql/ssl/client-cert.pem     # Client certificate
# ssl-key  = /etc/mysql/ssl/client-key.pem      # Client key


[mysqld]
port      = 3306                                # Default MySQL port
basedir   = /usr                                # Install directory (usually /usr)
datadir   = /var/lib/mysql                      # Data directory (mind permissions)
socket    = /var/run/mysqld/mysqld.sock         # Socket file for local connections
pid-file  = /var/run/mysqld/mysqld.pid          # PID file written on start

### --- Network & security ---
bind-address       = 0.0.0.0                 # 127.0.0.1 = local only; for remote: 0.0.0.0 (not without firewall!)
skip_networking    = 0                          # 1 = disable TCP/IP completely → socket only
skip_name_resolve  = 1                          # Disable DNS lookups (faster & safer)
max_connections    = 200                        # Max concurrent clients (workload dependent)
local_infile       = 0                          # Disable insecure LOAD DATA LOCAL (prevents exfil)
symbolic-links     = 0                          # Protect against symlink abuse
# secure_file_priv = /var/lib/mysql-files       # Safe import/export zone (path must exist)

### --- Storage & performance (InnoDB) ---
innodb_buffer_pool_size        = 4G             # Key setting: 50–80% of RAM (dedicated DB server)
innodb_redo_log_capacity       = 2G             # Total redo log size (replaces innodb_log_file_size in 8.x)
innodb_file_per_table          = 1              # Separate .ibd per table (recommended)
innodb_flush_log_at_trx_commit = 1              # 1 = ACID-safe; 2/0 = faster, risk on crash
# innodb_flush_method = O_DIRECT                # On Linux: bypass OS cache, less double buffering

### --- Character sets ---
character_set_server = utf8mb4                  # Full UTF-8 incl. emojis
collation_server     = utf8mb4_0900_ai_ci       # Modern collation (instead of utf8mb4_general_ci)

### --- Logging ---
log_error            = /var/log/mysql/error.log       # Error log (check on startup issues)
slow_query_log       = 1                              # Log slow queries (performance analysis)
slow_query_log_file  = /var/log/mysql/mysql-slow.log  # Path for slow queries
long_query_time      = 2                              # Anything >2 seconds is slow
log_queries_not_using_indexes = 1                     # Log queries without index (can grow logs)
# general_log        = 0                              # General query log → debugging only
# general_log_file   = /var/log/mysql/mysql-general.log

### --- Binary log / replication / PITR ---
log-bin       = /var/log/mysql/mysql-bin.log          # Enable binlog (path must be writable)
log-bin-index = /var/log/mysql/mysql-bin.index        # Index file for binlogs
sync_binlog   = 1                                     # ACID-safe, may cost performance
binlog_expire_logs_seconds = 864000                   # 10 days retention (instead of expire_logs_days)

### --- TLS/SSL for the server ---
require_secure_transport = ON                      # Enforces TLS for ALL clients
ssl-ca   = /etc/mysql/ssl/ca-cert.pem
ssl-cert = /etc/mysql/ssl/server-cert.pem
ssl-key  = /etc/mysql/ssl/server-key.pem


[mysqldump]
### --- Settings for dumps (client-side) ---
quick                                             # Row-by-row export (faster, less RAM)
quote-names                                       # Quote names with backticks
max_allowed_packet = 64M                          # Larger packets (e.g., big INSERTs or BLOBs)


### --- Notes ---
# - Directories (/var/log/mysql, /var/lib/mysql-files) must exist and be owned by mysql:mysql.
# - TLS certificates chmod 600 and owned by mysql:mysql.
# - After config/cert changes: service mysql restart.
# - Secure access: no remote root logins, strong passwords, separate DB users per app.
# - Test backups regularly, not only create them.
