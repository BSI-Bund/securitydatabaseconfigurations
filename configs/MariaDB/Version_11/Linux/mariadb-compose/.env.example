# ------------------------------------------------------------
# Default .env for docker-compose.yml (MariaDB 11 + Adminer)
# WARNING: Example values only. Do NOT use in production without changing secrets.
# ------------------------------------------------------------

# Image/Version
MARIADB_VERSION=11.8

# Timezone
TZ=Europe/Berlin

# Network / Ports
DB_PORT=3306

# Root credentials (change for production)
MARIADB_ROOT_PASSWORD=ChangeMe!Root123   # replace!

# Application database
MARIADB_DATABASE=appdb
MARIADB_USER=appuser
MARIADB_PASSWORD=ChangeMe!User456       # replace!

# Character set & collation are configured in docker-compose.yml:
# MARIADB_CHARACTER_SET_SERVER=utf8mb4
# MARIADB_COLLATION_SERVER=utf8mb4_general_ci
